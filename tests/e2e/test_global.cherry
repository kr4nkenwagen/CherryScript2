global var a = 1
global const b = 1
assert_eq(a, 1, "global: var is initalized")
assert_eq(b, 1, "global: const is initalized")

fn test() {
  a += 1
}
test()
assert_eq(a, 2, "global: var is accessible from within a function")
remove a, b, test

global var a = 0
global fn global_test() {
  out "dasdadsa\n"
  a = 1
}
fn test() {
  global_test()
}
test()
assert_eq(a, 1, "global: Global functions are accessible from function scopes")
remove a, b, test, global_test
