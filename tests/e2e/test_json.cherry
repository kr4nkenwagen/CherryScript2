# json: top-level primitive types
var data = json('{ "name": "Odin", "version": 1, "ratio": 3.14, "enabled": true, "disabled": false, "empty": null }')
assert_eq(data.name, "Odin", "json: string value")
assert_eq(data.version, 1, "json: integer value")
assert_eq(data.ratio, 3.14, "json: float value")
assert_eq(data.enabled, true, "json: boolean true")
assert_eq(data.disabled, false, "json: boolean false")
assert_eq(data.empty, null, "json: null value")
remove data

# json: deep nested objects
var config = json('{ "app": { "server": { "port": 8080, "host": "localhost" } } }')
assert_eq(config.app.server.port, 8080, "json: deep nested property access")
assert_eq(config.app.server.host, "localhost", "json: deep nested string access")
remove config


# json: arrays inside objects
var payload = json('{ "tags": ["admin", "dev"], "matrix": [[1, 2], [3, 4]] }')
assert_eq(len(payload.tags), 2, "json: array property length")
assert_eq(payload.tags[0], "admin", "json: array element access")
assert_eq(payload.matrix[1][0], 3, "json: nested array indexing")
remove payload

# json: array of objects
var users = json('{ "list": [{ "id": 101, "role": "user" }, { "id": 102, "role": "admin" }] }')
assert_eq(len(users.list), 2, "json: object array length")
assert_eq(users.list[1].id, 102, "json: object inside array property")
assert_eq(users.list[0].role, "user", "json: object inside array string property")
remove users

var dynamic = json('{ }')
dynamic.field = "test"
dynamic.child.field = "test"
assert_eq(dynamic.field, "test", "json: Dynamically assign new members")
assert_eq(dynamic.child.field, "test", "json: Dynamically assign new child members")
remove dynamic

# json: empty structures and edge values
var edge = json('{ "empty_obj": {}, "empty_arr": [], "negative": -42 }')
assert_eq(len(edge.empty_arr), 0, "json: empty array length == 0")
assert_eq(edge.negative, -42, "json: negative numbers")
remove edge
