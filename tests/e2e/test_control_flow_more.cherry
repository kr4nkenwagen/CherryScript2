# if / elif / else behavior
var y = 0
if (false) {
  y = 1
} elif (false) {
  y = 2
} else {
  y = 3
}
assert(y == 3, "control: if-elif-else (else branch)")

var z = 0
if (false) {
  z = 1
} elif (true) {
  z = 2
} elif (true) {
  z = 3
} else {
  z = 4
}
assert(z == 2, "control: elif order (first matching elif)")

# for loop: break
var k = 0
for (var i = 0; i < 5; i = i + 1) {
  if (i == 2) { break }
  k = k + 1
}
assert(k == 2, "control: for loop break stops iterations")

# for loop: continue
var c = 0
for (var i = 0; i < 3; i = i + 1) {
  if (i == 1) { continue }
  c = c + 1
}
assert(c == 2, "control: for loop continue skips body for that iteration")

# nested loops / break affects only inner loop
var o = 0
for (var a = 0; a < 3; a = a + 1) {
  for (var b = 0; b < 3; b = b + 1) {
    if (b == 1) { break }
    o = o + 1
  }
}
assert(o == 3, "control: nested loops with inner break")

# while loop: break
var w = 0
while (true) {
  if (w == 2) { break }
  w = w + 1
}
assert(w == 2, "control: while loop break")
