# if / elif / else behavior
var y = 0
if (false) {
  y = 1
} elif (false) {
  y = 2
} else {
  y = 3
}
assert_eq(y, 3, "control: if-elif-else (else branch)")
remove y

var z = 0
if (false) {
  z = 1
} elif (true) {
  z = 2
} elif (true) {
  z = 3
} else {
  z = 4
}
assert_eq(z, 2, "control: elif order (first elif)")
remove z

var z = 0
if (false) {
  z = 1
} elif (false) {
  z = 2
} elif (true) {
  z = 3
} else {
  z = 4
}
assert_eq(z, 3, "control: elif order (second elif)")
remove z


# for loop: break
var k = 0
for (var i = 0; i < 5; i = i + 1) {
  if (i == 2) { break }
  k = k + 1
}
assert_eq(k, 2, "control: for loop break stops iterations")
remove k

# for loop: continue
var c = 0
for (var i = 0; i < 3; i = i + 1) {
  if (i == 1) { continue }
  c = c + 1
}
assert_eq(c, 2, "control: for loop continue skips body for that iteration")
remove c

# nested loops / break affects only inner loop
var o = 0
for (var a = 0; a < 3; a+=1) {
  for (var b = 0; b < 3; b+=1) {
    if (b == 1) {
      break
    }
    o+=1
  }
}
assert_eq(o, 3, "control: nested loops with inner break")
remove o

# while loop: break
var w = 0
for (true) {
  if (w == 2) { break }
  w = w + 1
}
assert_eq(w, 2, "control: while loop break")
remove w
