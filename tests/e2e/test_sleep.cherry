# Test: sleep function accuracy and behavior

# - Test 1: Sleep for 0.2 seconds (200ms)
var start_min_1 = time.minute
var start_sec_1 = time.second
var start_ms_1 = time.millisecond
var start_total_1 = (start_min_1 * 60000) + (start_sec_1 * 1000) + start_ms_1

sleep(0.2)

var end_min_1 = time.minute
var end_sec_1 = time.second
var end_ms_1 = time.millisecond
var end_total_1 = (end_min_1 * 60000) + (end_sec_1 * 1000) + end_ms_1

var elapsed_1 = end_total_1 - start_total_1
assert(elapsed_1 >= 180, "sleep: 0.2s slept for at least ~200ms")

remove start_min_1
remove start_sec_1
remove start_ms_1
remove start_total_1
remove end_min_1
remove end_sec_1
remove end_ms_1
remove end_total_1
remove elapsed_1

# - Test 2: Sleep for 0.5 seconds (500ms)
var start_total_2 = (time.minute * 60000) + (time.second * 1000) + time.millisecond

sleep(0.5)

var end_total_2 = (time.minute * 60000) + (time.second * 1000) + time.millisecond
var elapsed_2 = end_total_2 - start_total_2

assert(elapsed_2 >= 450, "sleep: 0.5s slept for at least ~500ms")

remove start_total_2
remove end_total_2
remove elapsed_2

# - Test 3: Zero and micro-sleeps (ensure non-blocking/no crash)
sleep(0)
sleep(0.001)
