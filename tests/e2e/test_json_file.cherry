var file = @"testfile"
file<-0 = "{}"
var json_file = json(@"testfile")
json_file.member = 1
assert(file->0 == '{"member": 1}', "json file: new members are saved to file")
json_file.group.member = 1
assert(file->0 == '{"member": 1, "group": {"member": 1}}', "json file: new members are saved to file")
rm file
remove file json_file
