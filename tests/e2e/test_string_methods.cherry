# String methods: functionality tests
# Calling convention: string.method(obj, args...)

# --- contains ---
assert_true(string.contains("Hello, World!", "World"), "string.contains: basic match")
assert_false(string.contains("Hello, World!", "xyz"), "string.contains: no match returns false")
assert_true(string.contains("", ""), "string.contains: empty substring matches")
assert_true(string.contains("abc", "abc"), "string.contains: full string match")

# --- first_index_of ---
assert_eq(string.first_index_of("Hello, World!", "World"), 7, "string.first_index_of: finds first occurrence")
assert_eq(string.first_index_of("Hello, World!", "xyz"), -1, "string.first_index_of: not found returns -1")
assert_eq(string.first_index_of("aaa", "a"), 0, "string.first_index_of: first character")

# --- last_index_of ---
assert_eq(string.last_index_of("Hello, World!", "l"), 10, "string.last_index_of: finds last occurrence")
assert_eq(string.last_index_of("Hello, World!", "xyz"), -1, "string.last_index_of: not found returns -1")
assert_eq(string.last_index_of("aaa", "a"), 2, "string.last_index_of: last character")

# --- first_index_of_from ---
assert_eq(string.first_index_of_from("Hello, World!", "l", 5), 5, "string.first_index_of_from: search from offset")
assert_eq(string.first_index_of_from("Hello, World!", "l", 11), -1, "string.first_index_of_from: past last occurrence")
assert_eq(string.first_index_of_from("Hello, World!", "Hello", 0), 0, "string.first_index_of_from: from start")

# --- trim_start ---
assert_eq(string.trim_start("  hello  "), "hello  ", "string.trim_start: removes leading spaces")
assert_eq(string.trim_start("\t\nhello"), "hello", "string.trim_start: removes tabs and newlines")
assert_eq(string.trim_start("hello"), "hello", "string.trim_start: no whitespace is no-op")
assert_eq(string.trim_start("   "), "", "string.trim_start: all whitespace returns empty")

# --- trim_end ---
assert_eq(string.trim_end("  hello  "), "  hello", "string.trim_end: removes trailing spaces")
assert_eq(string.trim_end("hello\t\n"), "hello", "string.trim_end: removes tabs and newlines")
assert_eq(string.trim_end("hello"), "hello", "string.trim_end: no whitespace is no-op")
assert_eq(string.trim_end("   "), "", "string.trim_end: all whitespace returns empty")

# --- trim ---
assert_eq(string.trim("  hello  "), "hello", "string.trim: removes both sides")
assert_eq(string.trim("\t\nhello\t\n"), "hello", "string.trim: removes tabs and newlines both sides")
assert_eq(string.trim("hello"), "hello", "string.trim: no whitespace is no-op")
assert_eq(string.trim("   "), "", "string.trim: all whitespace returns empty")

# --- to_upper ---
assert_eq(string.to_upper("hello"), "HELLO", "string.to_upper: basic")
assert_eq(string.to_upper("Hello World"), "HELLO WORLD", "string.to_upper: preserves spaces")
assert_eq(string.to_upper("123"), "123", "string.to_upper: digits unchanged")

# --- to_lower ---
assert_eq(string.to_lower("HELLO"), "hello", "string.to_lower: basic")
assert_eq(string.to_lower("Hello World"), "hello world", "string.to_lower: preserves spaces")
assert_eq(string.to_lower("123"), "123", "string.to_lower: digits unchanged")

# --- pad_start ---
assert_eq(string.pad_start("hi", 5), "     hi", "string.pad_start: adds leading spaces")
assert_eq(string.pad_start("hello", 3), "   hello", "string.pad_start: adds spaces even if shorter")
assert_eq(string.pad_start("", 3), "   ", "string.pad_start: empty string")

# --- pad_end ---
assert_eq(string.pad_end("hi", 5), "hi     ", "string.pad_end: adds trailing spaces")
assert_eq(string.pad_end("hello", 3), "hello   ", "string.pad_end: adds spaces even if shorter")
assert_eq(string.pad_end("", 3), "   ", "string.pad_end: empty string")

# --- replace_all ---
assert_eq(string.replace_all("hello world", "world", "cherry"), "hello cherry", "string.replace_all: basic replacement")
assert_eq(string.replace_all("aaa", "a", "b"), "bbb", "string.replace_all: replaces all occurrences")
assert_eq(string.replace_all("hello", "x", "y"), "hello", "string.replace_all: no match returns original")
assert_eq(string.replace_all("", "a", "b"), "", "string.replace_all: empty string")
assert_eq(string.replace_all("aaa", "a", ""), "", "string.replace_all: replace with empty removes all")
