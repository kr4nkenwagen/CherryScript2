# System command execution via $"cmd" returns JSON object with stdout, stderr, exit_code

# Basic command
var result = $"pwd"
assert(len(result.stdout) > 0, "execute: pwd returns a non-empty path")
assert(result.stderr == "", "execute: pwd has empty stderr")
assert(result.exit_code == 0, "execute: pwd exits with 0")
remove result

# Command with arguments
var echo = $"echo hello"
assert(echo.stdout == "hello\n", "execute: echo stdout captured")
assert(len(echo.stderr) == 0, "execute: echo stderr is empty")
assert(echo.exit_code == 0, "execute: echo exit code is 0")
remove echo

# Command with -n flag (no trailing newline)
var echo_n = $"echo -n hello"
assert(echo_n.stdout == "hello", "execute: echo -n suppresses newline")
assert(echo_n.exit_code == 0, "execute: echo -n exit code is 0")
remove echo_n

# Stderr capture
var err_result = $"ls /nonexistent_path_12345"
assert(err_result.exit_code != 0, "execute: bad path has non-zero exit code")
assert(len(err_result.stderr) > 0, "execute: bad path produces stderr")
remove err_result

# Exit code from failed command
var fail = $"false"
assert(fail.exit_code == 1, "execute: false command exits with 1")
assert(len(fail.stdout) == 0, "execute: false has empty stdout")
remove fail

# JSON properties are accessible
var data = $"echo test"
assert(data.stdout == "test\n", "execute: stdout property works")
assert(len(data.stderr) == 0, "execute: stderr property works")
assert(data.exit_code == 0, "execute: exit_code property works")
remove data

# Execute in expression context
var cmd_result = $"echo -n cherry"
var combined = len(cmd_result.stdout)
assert(combined == 6, "execute: output usable in expressions")
remove cmd_result
remove combined
