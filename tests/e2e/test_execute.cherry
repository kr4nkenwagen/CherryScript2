# System command execution via $"cmd"
var pwd = $"pwd"
assert(len(pwd) > 0, "execute: pwd returns a non-empty path")

# Command with arguments
var echo = $"echo hello"
assert(echo == "hello\n", "execute: echo with arguments works")

# Command with -n flag (no trailing newline)
var echo_n = $"echo -n hello"
assert(echo_n == "hello", "execute: echo -n suppresses newline")

# Execute result can be used in expressions
var echo_len = $"echo -n cherry"
assert(len(echo_len) == 6, "execute: output usable in len()")

# Execute in assignment context
var output = $"echo cherry"
assert(output == "cherry\n", "execute: output captured in variable")

remove pwd, echo, echo_n, echo_len, output
