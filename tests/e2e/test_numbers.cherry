# Numbers: integers and floats forms, leading-dot floats
var i = 12
assert(len(i) == 2, "numbers: integer 12 length == 2")
remove i

var f = 12.34
assert(len(f) == 5, "numbers: float 12.34 length == 5")
remove f

var lf = .34
assert(len(lf) == 4, "numbers: leading-dot .34 length == 4(Cherry will add 0 before .")
remove lf

# Dot vs range operator: ensure .. is not eaten by number parsing
var arr = [1,2]
# sanity check for parser/lexer correctness
assert(len(12) == 2, "numbers: sanity integer length")
remove arr
