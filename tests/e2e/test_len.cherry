# Test: len() for various types
# - arrays
var arr = [1, 2, 3]
assert_eq(len(arr), 3, "len: array length == 3")
remove arr

# - strings
var str = "Hello World"
assert_eq(len(str), 11, "len: string length == 11")
remove str

# - integers
var number = 1234567890
assert_eq(len(number), 10, "len: integer digit count == 10")
remove number

# - floats
var float = 12.34
assert_eq(len(float), 5, "len: float representation length == 5")
remove float

# - file lines
var file = @"tests/tmp/tmp_len_test_file"
# ensure file is clean
rm file
file<-3 = "test"
assert_eq(len(file), 4, "len: file length (lines) == 4")
rm file
remove file
