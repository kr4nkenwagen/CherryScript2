# Every non-interactive example in examples/ must run to completion (exit code 0).
# Runs each with the interpreter under test, so a regressing example fails the suite.
# The interactive example (number_guessing.cherry) is exercised separately in tests/run.sh.
# Offline machines: add  `examples/http_request exits 0`  to tests/expected_failures.txt

var res_ex_hello = $"tests/tmp/cherry examples/hello.cherry"
if(res_ex_hello.exit_code != 0) { println("stderr: " .. res_ex_hello.stderr) }
assert_eq(res_ex_hello.exit_code, 0, "examples/hello exits 0")
remove res_ex_hello

