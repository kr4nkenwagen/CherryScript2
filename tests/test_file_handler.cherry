module "utils/assert.cherry"
var file = @"testfile"
out len(file) .. "\n"
assert(exists(file), "exists function if file exists")
file<-3 = "test"
rm file
assert(!exists(file), "exists function if file has been removed")
remove file
var file = @"testfile"
assert(len(file) == 0, "newly created file should be 0 length")
file<-3 = "test"
assert(file->1 == "", "first line is empty")
assert(file->2 == "", "second line is empty")
assert(file->3 == "test", "third line contains 'test'")
assert(file->len(file) == "test", "third and last line contains 'test'")
file<-len(file) ="last line"
assert(file->len(file) == "last line", "last line contains 'test'")
file<-3 = "replaced"
assert(file->3 == "replaced", "replaced line is correctly replaced")
rm file

