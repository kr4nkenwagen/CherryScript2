module "utils/assert.cherry"

# File handler tests using a unique test file path
var tf = @"tests/tmp_file_handler_test"

# Ensure clean start
rm tf

# create/write and check exists
file<-3 = "test"
assert(exists(tf), "file: exists after write")

# remove and verify deletion
rm tf
assert(!exists(tf), "file: not exists after rm")

# Recreate file and check content placement
var file = @"tests/tmp_file_handler_test"
# ensure empty file
rm file
var _ = file  # ensure file variable refers
file<-3 = "test"
assert(len(file) == 4, "file: len after writing one line (incl empties)")

assert(file->1 == "", "file: first line empty")
assert(file->2 == "", "file: second line empty")
assert(file->3 == "test", "file: third line contains test")
assert(file->len(file) == "test", "file: last line by len(file) returns test")

# replace and verify
file<-3 = "replaced"
assert(file->3 == "replaced", "file: replaced line is correct")

# cleanup
rm file
