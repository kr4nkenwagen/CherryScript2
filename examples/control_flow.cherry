# for loop with break: prints 0..4 then stops at 5
for(var i = 0; i < 10; i += 1) {
  if(i == 5) {
    println("breaking at " .. i)
    break
  }
  println("for iteration: " .. i)
}

# while-style loop (for with condition only) and continue:
# prints every iteration from 1..10 except 5
var j = 0
for(j < 10) {
  j += 1
  if(j == 5) {
    continue
  }
  println("while iteration: " .. j)
}
remove j

# if / elif / else chain
if(false) {
  println("I will not trigger.")
} elif(false) {
  println("I will not trigger.")
} else {
  println("Hello World!")
}
