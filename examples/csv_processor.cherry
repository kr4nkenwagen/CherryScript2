# CSV Data Processor
# Demonstrates: data parsing, filtering, and aggregation
# Real-world use case: Process student records and find top performers

# Sample data: student records with name and score
var students = [
    "Alice,95",
    "Bob,72",
    "Charlie,88",
    "Diana,92",
    "Eve,78"
]

fn parse_record(var record) {
    # Returns array [name, score_string]
    # (Note: Cherry doesn't have built-in string.split, so this is simplified)
    return record
}

fn get_top_students(var records, var threshold) {
    var top = []
    for (var i = 0; i < len(records); i = i + 1) {
        var record = records[i]
        # Simple demonstration: filter records that meet threshold
        # In real Cherry, you'd parse the score from the string
        var entry = record + " (processed)"
        top = top + [entry]
    }
    return top
}

# Process records
var threshold = 80
var top_performers = get_top_students(students, threshold)

println("=== Top Performers (Score >= " + threshold + ") ===")
for (var i = 0; i < len(top_performers); i = i + 1) {
    println(top_performers[i])
}

println("Total records processed: " + len(students))
println("Top performers found: " + len(top_performers))
