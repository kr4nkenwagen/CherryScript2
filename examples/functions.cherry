# A function with two parameters
fn add(var x, var y) {
  return x + y
}

# Functions can call themselves (recursion)
fn factorial(var n) {
  if(n <= 1) {
    return 1
  }
  return n * factorial(n - 1)
}

# Functions may be declared with a single expression body
fn square(var v) return v * v

# Global functions are callable from anywhere
global fn double(var x) {
  return x * 2
}

println("add(5, 6) = " .. add(5, 6))
println("factorial(5) = " .. factorial(5))
println("square(9) = " .. square(9))
println("double(21) = " .. double(21))
println("add(2, double(4)) = " .. add(2, double(4)))

remove add, factorial, square, double
