# Mutable variables. Several may be declared in a single statement.
var a = 1, b = 2

# Immutable variables. Need to be assigned a value on declaration.
const c = 3, d = "abc"

# Global variables are accessible across all scopes.
global var e = 1.23
global const f = .23

println("a = " .. a .. "  b = " .. b)
println("c = " .. c .. "  d = " .. d)
println("e = " .. e .. "  f = " .. f)

# Removes variables from memory. Useful when using many modules.
remove a, b, c, d, e, f
